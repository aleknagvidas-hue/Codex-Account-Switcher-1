root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,sln,xaml,cmd,ps1}]
end_of_line = crlf

[*.{md,yml,yaml,json}]
end_of_line = lf

[*.cs]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

[*.{xaml,xml}]
indent_style = space
indent_size = 4
