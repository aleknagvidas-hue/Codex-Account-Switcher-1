<Window x:Class="CodexAccountSwitcher.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" Height="470"
        Title="Account settings"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#01000000" AllowsTransparency="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Margin="1" Padding="28" CornerRadius="24" Background="#EB191C25" BorderBrush="#38FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Text="Account name" />
            <TextBlock Grid.Row="1" Margin="0,8,0,20" Foreground="{StaticResource TextSecondary}"
                       Text="Choose a private label. Do not enter an email address." />
            <TextBox x:Name="AliasBox" Grid.Row="2" Height="48" Padding="14,11" FontSize="16"
                     Foreground="White" Background="#18FFFFFF" BorderBrush="#32FFFFFF" BorderThickness="1"
                     CaretBrush="White" MaxLength="40" />

            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock Foreground="{StaticResource TextSecondary}" Text="Purchase link (optional)" />
                <TextBox x:Name="PurchaseLinkBox" Height="44" Margin="0,8,0,0" Padding="12,9" FontSize="13"
                         Foreground="White" Background="#18FFFFFF" BorderBrush="#32FFFFFF" BorderThickness="1"
                         CaretBrush="White" MaxLength="2048" ToolTip="Link to the seller, listing, receipt, or order page" />
                <TextBlock x:Name="LinkErrorText" Margin="0,5,0,0" FontSize="10.5" Foreground="#FF9095"
                           Text="Enter a complete http:// or https:// link." Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,18,0,0">
                <TextBlock Foreground="{StaticResource TextSecondary}" Text="Color" />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Button Click="Color_Click" Tag="#7C8CFF" Background="#7C8CFF" Style="{StaticResource ColorButtonStyle}" />
                    <Button Click="Color_Click" Tag="#46C7B4" Background="#46C7B4" Style="{StaticResource ColorButtonStyle}" />
                    <Button Click="Color_Click" Tag="#E881A6" Background="#E881A6" Style="{StaticResource ColorButtonStyle}" />
                    <Button Click="Color_Click" Tag="#F3AD63" Background="#F3AD63" Style="{StaticResource ColorButtonStyle}" />
                    <Button Click="Color_Click" Tag="#AA85E8" Background="#AA85E8" Style="{StaticResource ColorButtonStyle}" />
                    <Button Click="Color_Click" Tag="#71A9F7" Background="#71A9F7" Style="{StaticResource ColorButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="96" Margin="0,0,10,0" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
                <Button Width="96" Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
