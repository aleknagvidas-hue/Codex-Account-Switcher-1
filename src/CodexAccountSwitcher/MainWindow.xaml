<Window x:Class="CodexAccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Account Switcher" Width="900" Height="780" MinWidth="820" MinHeight="620"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" ShowActivated="True"
        Background="#14171D" Closing="Window_Closing">
    <Grid>
        <Border Margin="1" CornerRadius="22" Background="#F314171D" BorderBrush="#40FFFFFF" BorderThickness="1" />
        <Grid Margin="24,18,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Codex accounts" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource TextSecondary}"
                               Text="Ranked by soonest usable  •  green ready  •  orange close  •  red longer wait" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="76" Padding="6" Content="Refresh" ToolTip="Refresh usage" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" />
                    <Button Width="62" Margin="6,0,0,0" Padding="6" Content="Quit" ToolTip="Exit the app completely" Style="{StaticResource SecondaryButton}" Click="Exit_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,8,0,14" Padding="14,10" CornerRadius="13" Background="#16FFFFFF" BorderBrush="#2CFFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Summary}" />
                        <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Text="{Binding RefreshDescription}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Content="Auto" IsChecked="{Binding BackgroundRefresh}" />
                    <ComboBox Grid.Column="2" Width="72" Foreground="#111318" Background="#F2F2F4" VerticalContentAlignment="Center"
                              ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding RefreshMinutes}" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="AccountsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AccountsList" ItemsSource="{Binding PanelAccounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,11" Padding="14,13" CornerRadius="17"
                                    Background="{Binding CardBackground}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="52" Height="92" VerticalAlignment="Top" CornerRadius="15"
                                            Background="{Binding RankBackground}" BorderBrush="{Binding ClockBrush}" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding ClockBrush}" Text="ORDER" />
                                            <TextBlock Margin="0,-2,0,-2" HorizontalAlignment="Center" FontSize="31" FontWeight="Bold"
                                                       Foreground="White" Text="{Binding ResetOrderText}" />
                                            <TextBlock MaxWidth="46" HorizontalAlignment="Center" TextAlignment="Center" FontSize="8"
                                                       FontWeight="SemiBold" Foreground="{Binding ClockBrush}" Text="{Binding PriorityText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Column="1" Margin="2,0,16,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="34" Height="34" Margin="0,0,9,0">
                                                <Ellipse Fill="{Binding ColorHex}" />
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding Initial}" />
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock MaxWidth="260" FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    <Border Margin="7,0,0,0" Padding="7,2" CornerRadius="6" Background="#264DD39A"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock FontSize="8.5" FontWeight="Bold" Foreground="#7CE0B6" Text="ACTIVE" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0" FontSize="9.5" Foreground="{StaticResource TextSecondary}" Text="{Binding PlanText}" />
                                            </StackPanel>
                                            <Border Margin="12,4,0,0" Padding="9,4" VerticalAlignment="Top" CornerRadius="7" Background="{Binding StatusBackground}">
                                                <TextBlock FontSize="9" FontWeight="Bold" Foreground="{Binding StatusForeground}" Text="{Binding AvailabilityStatusText}" />
                                            </Border>
                                        </StackPanel>

                                        <Grid Grid.Row="1" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="142" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Text="5-HOUR" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="{Binding ShortTermPercentText}" />
                                            <ProgressBar Grid.Column="2" Margin="8,0,10,0" VerticalAlignment="Center" Maximum="100" Value="{Binding ShortTermValue, Mode=OneWay}"
                                                         Foreground="{Binding ClockBrush}" Style="{StaticResource GlassProgress}" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="9.5" Foreground="#D8DBE5" Text="{Binding ShortTermResetText}" />
                                        </Grid>

                                        <Grid Grid.Row="2" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="142" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Text="WEEKLY" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="{Binding WeeklyPercentText}" />
                                            <ProgressBar Grid.Column="2" Margin="8,0,10,0" VerticalAlignment="Center" Maximum="100" Value="{Binding WeeklyValue, Mode=OneWay}"
                                                         Foreground="{Binding ClockBrush}" Style="{StaticResource GlassProgress}" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="9.5" Foreground="#D8DBE5" Text="{Binding WeeklyResetText}" />
                                        </Grid>

                                        <TextBlock Grid.Row="3" Margin="0,9,0,0" FontSize="9.5" Foreground="{StaticResource TextSecondary}"
                                                   Text="{Binding FreshnessText}" ToolTip="{Binding UsageHint}" />
                                    </Grid>

                                    <Border Grid.Column="2" Margin="0,0,12,0" Padding="10" CornerRadius="14"
                                            Background="{Binding ClockSurface}" BorderBrush="{Binding ClockBrush}" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" FontSize="27" FontFamily="Segoe UI Symbol" Foreground="{Binding ClockBrush}" Text="◷" />
                                            <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="8.5" FontWeight="Bold"
                                                       Foreground="{Binding ClockBrush}" Text="{Binding AvailabilityClockCaption}" />
                                            <TextBlock Margin="0,1,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"
                                                       Foreground="White" Text="{Binding AvailabilityClockText}" />
                                            <TextBlock Margin="0,3,0,0" MaxWidth="126" HorizontalAlignment="Center" TextAlignment="Center"
                                                       FontSize="9" Foreground="#D9DCE5" Text="{Binding AvailabilityExactText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <Button Width="88" Content="{Binding SwitchLabel}" IsEnabled="{Binding CanSwitch}" Style="{StaticResource PrimaryButton}" Tag="{Binding}" Click="Switch_Click" />
                                        <Button Width="88" Margin="0,6,0,0" Content="Reconnect" Padding="4" ToolTip="Renew this saved login, then switch to it"
                                                Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="Reconnect_Click" />
                                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Width="40" Padding="3" Content="Edit" ToolTip="Rename" Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="Rename_Click" />
                                            <Button Width="46" Margin="4,0,0,0" Padding="3" Content="Remove" ToolTip="Remove local profile"
                                                    Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="Delete_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Content="Save current account" Style="{StaticResource SecondaryButton}" Click="SaveCurrent_Click" />
                <Button Grid.Column="2" Content="+ Sign in with another account" Style="{StaticResource PrimaryButton}" Click="Login_Click" />
            </Grid>

            <Border Grid.Row="4" Margin="0,12,0,0" Padding="11,8" CornerRadius="10" Background="#12FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}" Text="{Binding Status}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#FFAEAE" Text="{Binding LastError}" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                              Content="Start with Windows" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed" />
                    <Button Grid.Column="2" Margin="6,0,0,0" Content="Exit app" Style="{StaticResource SecondaryButton}" Click="Exit_Click" />
                </Grid>
            </Border>

            <Border Grid.RowSpan="5" x:Name="BusyOverlay" Background="#B014171D" CornerRadius="18"
                    Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel MaxWidth="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                    <TextBlock Margin="0,12,0,0" FontSize="12" Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Margin="0,16,0,0" Content="Cancel" HorizontalAlignment="Center" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
