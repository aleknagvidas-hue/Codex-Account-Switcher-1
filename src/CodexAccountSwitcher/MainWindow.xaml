<Window x:Class="CodexAccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Account Switcher" Width="620" Height="690" MinWidth="560" MinHeight="540"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" ShowActivated="True"
        Background="#14171D" Closing="Window_Closing">
    <Grid>
        <Border Margin="1" CornerRadius="22" Background="#F314171D" BorderBrush="#40FFFFFF" BorderThickness="1" />
        <Grid Margin="24,18,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Codex accounts" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource TextSecondary}" Text="{Binding Summary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="70" Padding="6" Content="Refresh" ToolTip="Refresh usage" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" />
                    <Button Width="62" Margin="6,0,0,0" Padding="6" Content="Quit" ToolTip="Exit the app completely" Style="{StaticResource SecondaryButton}" Click="Exit_Click" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="0,10,0,14" Padding="14,11" CornerRadius="13" Background="#16FFFFFF" BorderBrush="#2CFFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Saved accounts" />
                        <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Text="{Binding RefreshDescription}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Content="Auto" IsChecked="{Binding BackgroundRefresh}" />
                    <ComboBox Grid.Column="2" Width="72" Foreground="#111318" Background="#F2F2F4" VerticalContentAlignment="Center" ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding RefreshMinutes}" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding PanelAccounts}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="15" Background="#C620232B" BorderBrush="#2DFFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid Width="34" Height="34" VerticalAlignment="Top">
                                    <Ellipse Fill="{Binding ColorHex}" />
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding Initial}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="6,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock MaxWidth="255" FontSize="14.5" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <Border Margin="7,0,0,0" Padding="6,2" CornerRadius="6" Background="#264DD39A" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="8.5" FontWeight="SemiBold" Foreground="#7CE0B6" Text="ACTIVE" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,7,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F2F7" Text="{Binding ShortTermText}" />
                                    <Border Margin="0,4,0,0" Padding="8,4" HorizontalAlignment="Left" CornerRadius="7" Background="#3D7C8CFF" Visibility="{Binding HasShortTermReset, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#C9CEFF" Text="{Binding ShortTermResetText}" />
                                    </Border>
                                    <TextBlock Margin="0,8,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F2F7" Text="{Binding WeeklyDetailText}" />
                                    <Border Margin="0,4,0,0" Padding="8,4" HorizontalAlignment="Left" CornerRadius="7" Background="#3346C7B4" Visibility="{Binding HasWeeklyReset, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#A6F1DE" Text="{Binding WeeklyResetText}" />
                                    </Border>
                                    <TextBlock Margin="0,6,0,0" FontSize="9.5" Foreground="{StaticResource TextSecondary}" Text="{Binding FreshnessText}" ToolTip="{Binding UsageHint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Width="74" Content="{Binding SwitchLabel}" IsEnabled="{Binding CanSwitch}" Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="Switch_Click" />
                                    <Button Margin="0,5,0,0" Content="Reconnect" Padding="4" ToolTip="Renew this saved login, then switch to it" Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="Reconnect_Click" />
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Width="44" Padding="4" Content="Edit" ToolTip="Rename" Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="Rename_Click" />
                                        <Button Width="58" Margin="4,0,0,0" Padding="4" Content="Remove" ToolTip="Remove local profile" Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="Delete_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Content="Save current account" Style="{StaticResource SecondaryButton}" Click="SaveCurrent_Click" />
                <Button Grid.Column="2" Content="+ Sign in with another account" Style="{StaticResource PrimaryButton}" Click="Login_Click" />
            </Grid>
            <Border Grid.Row="4" Margin="0,12,0,0" Padding="11,8" CornerRadius="10" Background="#12FFFFFF">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}" Text="{Binding Status}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#FFAEAE" Text="{Binding LastError}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Content="Start with Windows" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed" />
                    <Button Grid.Column="2" Margin="6,0,0,0" Content="Exit app" Style="{StaticResource SecondaryButton}" Click="Exit_Click" />
                </Grid>
            </Border>
            <Border Grid.RowSpan="5" x:Name="BusyOverlay" Background="#B014171D" CornerRadius="18" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel MaxWidth="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                    <TextBlock Margin="0,12,0,0" FontSize="12" Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Margin="0,16,0,0" Content="Cancel" HorizontalAlignment="Center" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
