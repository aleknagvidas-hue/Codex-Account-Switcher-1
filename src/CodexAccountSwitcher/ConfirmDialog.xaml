<Window x:Class="CodexAccountSwitcher.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="450" Height="270" WindowStyle="None" ResizeMode="NoResize"
        Title="Confirm"
        Background="#01000000" AllowsTransparency="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Margin="1" Padding="28" CornerRadius="24" Background="#F0181B24" BorderBrush="#38FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,14,0,20" TextWrapping="Wrap"
                       FontSize="14" LineHeight="22" Foreground="{StaticResource TextSecondary}" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="104" Margin="0,0,10,0" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Width="124" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
